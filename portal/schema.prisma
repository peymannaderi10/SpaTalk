datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// The portal owns the `public` schema and nothing else. No model here mirrors
// a table in the runtime's `runtime` schema: tenants, conversations, tracked
// items and usage are read and written over the runtime's /internal API.

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  // A person carries no subscription. A clinic does: see `Organization`.
  memberships               Membership[]
}

/// A client of the agency. `runtimeTenantId` is the runtime's tenant slug: it
/// is the only handle the portal keeps on runtime data, which it reads and
/// writes over /internal.
model Organization {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  name                      String
  slug                      String          @unique
  runtimeTenantId           String          @unique

  // Billing, per clinic. `stripeCustomerId` is learned from Stripe's
  // `checkout.session.completed`, which carries the organisation id we put on
  // the Checkout Session; every later Stripe event finds the organisation by it.
  stripeCustomerId          String?         @unique
  subscriptionStatus        String?         // 'active', 'trialing', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'frontdesk'

  memberships               Membership[]
  invitations               Invitation[]
}

/// Who may see an organisation, and what they may do in it. An OWNER changes
/// settings and billing; STAFF see everything and act on tracked items.
model Membership {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  userId                    String
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId            String
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                      OrgRole

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// A single-use invitation to join an organisation. It expires seven days
/// after it is created and is spent the moment it is accepted.
model Invitation {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String
  organizationId            String
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                      OrgRole
  token                     String          @unique
  expiresAt                 DateTime
  acceptedAt                DateTime?

  @@index([organizationId, email])
}

enum OrgRole {
  OWNER
  STAFF
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}
