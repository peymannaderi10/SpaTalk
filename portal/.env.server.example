# Portal server environment. Copy to .env.server and fill in real values.
# .env.server is gitignored and must never be committed.

# --- Database -----------------------------------------------------------
# The portal owns the `public` schema of its own database. The runtime keeps
# its `runtime` schema in the `spatalk` database on the same server; see
# docs/runbooks/accounts-and-env.md for which database the portal points at.
DATABASE_URL=postgresql://spatalk:spatalk@localhost:5434/spatalk

# --- Wasp ---------------------------------------------------------------
# 64 hex characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-characters
WASP_WEB_CLIENT_URL=http://localhost:3000
WASP_SERVER_URL=http://localhost:3001

# Comma-separated. A user signing up with one of these emails becomes an
# agency admin, who bypasses organisation membership checks.
ADMIN_EMAILS=you@example.com

# --- Email --------------------------------------------------------------
# The provider is chosen at compile time. Leave PORTAL_EMAIL_PROVIDER unset to
# send through SMTP (Amazon SES in production). Set it to Dummy for local
# development and the end-to-end tests: Wasp then prints the message, including
# the email verification link, to the server log instead of sending it.
PORTAL_EMAIL_PROVIDER=Dummy
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=ses-smtp-user
SMTP_PASSWORD=ses-smtp-password
MAIL_FROM=no-reply@spatalk.ca
MAIL_FROM_NAME=SpaTalk

# --- Stripe -------------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3001/payments-webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# The recurring price for the AI front desk subscription.
STRIPE_PRICE_ID_FRONTDESK=price_...
# Optional. A Stripe no-code customer portal link. Left empty, the app creates
# a billing portal session through the API instead.
STRIPE_CUSTOMER_PORTAL_URL=

# --- Runtime ------------------------------------------------------------
# The portal's only way into tenant, conversation, item and usage data.
RUNTIME_INTERNAL_URL=http://localhost:8000
RUNTIME_INTERNAL_KEY=change-me-same-value-as-runtime-INTERNAL_API_KEY

# --- Google sign-in (optional) -----------------------------------------
# Google auth is compiled in only when both values are present at build time.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
