# WAL-G credentials for the database container. Copy to `walg.env` beside this file
# and fill it in; `walg.env` is gitignored and must never be committed.
#
# WAL-G speaks S3, and Cloudflare R2 is S3-compatible, so the four R2_* values from
# `docs/runbooks/accounts-and-env.md` step 1 go in under their AWS names:
#
#   R2_ACCESS_KEY_ID     -> AWS_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY -> AWS_SECRET_ACCESS_KEY
#   R2_ENDPOINT          -> AWS_ENDPOINT
#   R2_BUCKET            -> the bucket half of WALG_S3_PREFIX
#
# With this file absent the archive command and the cron jobs are no-ops: the
# database runs, nothing is backed up, and `docker compose up -d db` still works on
# a clean checkout. That is the developer-machine default, not a production one.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
# R2 has one region and it is called `auto`; path-style addressing is required.
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true

WALG_S3_PREFIX=s3://spatalk-backups/pg
WALG_COMPRESSION_METHOD=brotli

# wal-g connects to the database to bracket a base backup. This cluster has no
# `postgres` role -- POSTGRES_USER is `spatalk` -- so libpq needs telling.
PGHOST=/var/run/postgresql
PGUSER=spatalk
PGDATABASE=spatalk
