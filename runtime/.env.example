# --- database ---
DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk
TEST_DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk_test

# --- public endpoints ---
PUBLIC_BASE_URL=https://api.example.com        # HTTP: webhooks, action links (Cloudflare-proxied)
MEDIA_WS_HOST=media.example.com                # WebSocket media host (DNS-only, straight to VPS)
API_HOST=api.example.com                       # Caddy site names (Task 16)
MEDIA_HOST=media.example.com
APP_HOST=app.example.com                       # portal client (Task C9); Caddy -> portal-web:80
APP_API_HOST=app-api.example.com               # portal server; Caddy -> portal-server:3001, and the
                                               # client is built against https://$APP_API_HOST
SECRET_KEY=change-me-64-hex                    # signs stream tokens and action links

# --- providers (swap by changing these) ---
TELNYX_API_KEY=
SONIOX_API_KEY=
INWORLD_API_KEY=
INWORLD_VOICE=Ashley
INWORLD_MODEL=inworld-tts-2
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=soniox                            # soniox | deepgram_flux
TTS_PROVIDER=inworld                           # inworld | deepgram_aura2
DEEPGRAM_API_KEY=

# --- delivery ---
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=frontdesk@example.com
SLACK_SIGNING_SECRET=

# --- text channels (Task B2) ---
EDGE_SHARED_KEY=                               # shared with the Cloudflare SMS worker
TELNYX_PUBLIC_KEY=                             # base64 Ed25519 key; only needed without the worker

# --- web chat widget (Task B4) ---
TURNSTILE_SITE_KEY=                            # public; served to the widget
TURNSTILE_SECRET_KEY=                          # set to make /chat/ws challenge; empty = no challenge

# --- human takeover (Task B5) ---
SLACK_BOT_TOKEN=                               # xoxb-...; set to give each conversation a Slack thread

# --- tenant secrets referenced by bundles (name = what the bundle references) ---
SKINCENTRIX_SLACK_WEBHOOK=

# --- portal control plane (Task C3) ---
INTERNAL_API_KEY=                              # shared with the portal's RUNTIME_INTERNAL_KEY; empty = /internal refuses everyone
GIT_COMMIT=                                    # set by the image build; reported by /healthz

# --- instagram and facebook page (Task D1) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=                          # also the HMAC key for /instagram/webhook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=                           # also the HMAC key for /messenger/webhook
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=                # any string; echoed back on the hub handshake
META_TOKEN_ENCRYPTION_KEY=                     # Fernet key; empty = no Meta token can be stored
META_GRAPH_VERSION=v21.0
