# --- database ---
DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk
TEST_DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk_test

# --- public endpoints ---
PUBLIC_BASE_URL=https://api.example.com        # HTTP: webhooks, action links (Cloudflare-proxied)
MEDIA_WS_HOST=media.example.com                # WebSocket media host (DNS-only, straight to VPS)
API_HOST=api.example.com                       # Caddy site names (Task 16)
MEDIA_HOST=media.example.com
SECRET_KEY=change-me-64-hex                    # signs stream tokens and action links

# --- providers (swap by changing these) ---
TELNYX_API_KEY=
SONIOX_API_KEY=
INWORLD_API_KEY=
INWORLD_VOICE=Ashley
INWORLD_MODEL=inworld-tts-2
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
STT_PROVIDER=soniox                            # soniox | deepgram_flux
TTS_PROVIDER=inworld                           # inworld | deepgram_aura2
DEEPGRAM_API_KEY=

# --- delivery ---
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=frontdesk@example.com
SLACK_SIGNING_SECRET=

# --- text channels (Task B2) ---
EDGE_SHARED_KEY=                               # shared with the Cloudflare SMS worker
TELNYX_PUBLIC_KEY=                             # base64 Ed25519 key; only needed without the worker

# --- tenant secrets referenced by bundles (name = what the bundle references) ---
SKINCENTRIX_SLACK_WEBHOOK=
