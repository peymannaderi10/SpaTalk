# A note goes on its own line, never after an empty value: `KEY=   # note` is read as the
# note by python-dotenv and by Docker Compose alike (2026-09-05, TELNYX_PUBLIC_KEY held its
# own comment and every Telnyx webhook was rejected). `spatalk serve` refuses to start on
# such a line and names the key.

# --- database ---
# The `db` container's password. Compose reads this file for `${...}` too, so it is what
# the container is created with and what both DATABASE_URLs inside the compose network
# use. Production: set a real one before the first `docker compose up`; Postgres reads it
# once, when the data volume is initialised.
POSTGRES_PASSWORD=spatalk
# The host address Postgres is published on. Leave it on loopback on a server: 0.0.0.0 on
# a VPS is Postgres on the public internet. 0.0.0.0 on a developer machine whose tools run
# in another VM (WSL reaching Docker Desktop).
DB_BIND=127.0.0.1
DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk
TEST_DATABASE_URL=postgresql+asyncpg://spatalk:spatalk@localhost:5434/spatalk_test

# --- public endpoints ---
PUBLIC_BASE_URL=https://api.example.com        # HTTP: webhooks, action links (Cloudflare-proxied)
MEDIA_WS_HOST=media.example.com                # WebSocket media host (DNS-only, straight to VPS)
API_HOST=api.example.com                       # Caddy site names (Task 16)
MEDIA_HOST=media.example.com
APP_HOST=app.example.com                       # portal client (Task C9); Caddy -> portal-web:80
APP_API_HOST=app-api.example.com               # portal server; Caddy -> portal-server:3001, and the
                                               # client is built against https://$APP_API_HOST
SECRET_KEY=change-me-64-hex                    # signs stream tokens and action links

# --- providers (swap by changing these) ---
TELNYX_API_KEY=
SONIOX_API_KEY=
SONIOX_VOICE=Bryce
INWORLD_API_KEY=
INWORLD_VOICE=Ashley
INWORLD_MODEL=inworld-tts-2
GOOGLE_API_KEY=
# LLM_MODEL names the vendor as well as the model (operations plan, Task E6):
# a bare name is Google, `openai:<model>` is OpenAI and then OPENAI_API_KEY is required.
LLM_MODEL=gemini-2.5-flash
# Second LLM vendor, for the swap drill in docs/runbooks/model-swap.md. Empty is fine.
OPENAI_API_KEY=
# --- LLM failover (plan F, tasks F1 and F2) ---
# The second model every turn falls back to, in the same vendor:model syntax as LLM_MODEL.
# EMPTY = no failover, which is exactly today's behaviour. Set it to a model at a DIFFERENT
# vendor and set that vendor's key below, e.g. LLM_MODEL_FALLBACK=openai:gpt-4.1-mini.
LLM_MODEL_FALLBACK=
# When a vendor is treated as down, and for how long the runtime avoids it.
LLM_BREAKER_FAILURES=3
LLM_BREAKER_WINDOW_SECS=60
LLM_BREAKER_COOLDOWN_SECS=300
# Every OpenAI-compatible host is a vendor: prefix LLM_MODEL or LLM_MODEL_FALLBACK with the
# vendor name and set only that vendor's key. All empty by default.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DASHSCOPE_API_KEY=
# compat: is any other OpenAI-compatible host; it is the only vendor whose URL has no default.
COMPAT_API_KEY=
LLM_COMPAT_BASE_URL=
# Each vendor's host, overriding the built-in default (a region change, e.g.
# LLM_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
LLM_OPENAI_BASE_URL=
LLM_OPENROUTER_BASE_URL=
LLM_DEEPSEEK_BASE_URL=
LLM_XAI_BASE_URL=
LLM_GROQ_BASE_URL=
LLM_TOGETHER_BASE_URL=
LLM_FIREWORKS_BASE_URL=
LLM_DASHSCOPE_BASE_URL=
STT_PROVIDER=soniox                            # soniox | deepgram_flux
TTS_PROVIDER=inworld                           # soniox | inworld | deepgram_aura2
DEEPGRAM_API_KEY=

# --- delivery ---
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=frontdesk@example.com
SLACK_SIGNING_SECRET=

# --- text channels (Task B2) ---
# shared with the Cloudflare SMS worker
EDGE_SHARED_KEY=
# base64 Ed25519 key; only needed without the worker
TELNYX_PUBLIC_KEY=

# --- web chat widget (Task B4) ---
# public; served to the widget
TURNSTILE_SITE_KEY=
# set to make /chat/ws challenge; empty = no challenge
TURNSTILE_SECRET_KEY=

# --- human takeover (Task B5) ---
# xoxb-...; set to give each conversation a Slack thread
SLACK_BOT_TOKEN=

# --- slack one-click connect (onboarding roadmap, section 3) ---
# From api.slack.com, the Front Desk app, Basic Information, App Credentials. With both set,
# a clinic connects its own workspace from Settings, Integrations: the bot token and the
# incoming webhook are stored encrypted with META_TOKEN_ENCRYPTION_KEY, and the per-tenant
# webhook line below is not needed for that clinic. The app must be set to public
# distribution and have https://<PUBLIC_BASE_URL>/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- tenant secrets referenced by bundles (name = what the bundle references) ---
# The manual fallback for a clinic that has not connected its workspace from the portal.
SKINCENTRIX_SLACK_WEBHOOK=

# --- portal control plane (Task C3) ---
# shared with the portal's RUNTIME_INTERNAL_KEY; empty = /internal refuses everyone
INTERNAL_API_KEY=
# Reported by /healthz. Leave it empty: the image build (scripts/deploy.sh) bakes the
# revision into the image itself and fills this in when it is blank.
GIT_COMMIT=

# --- backups (Task E2) ---
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT and R2_BUCKET are not read by
# the runtime process. WAL-G reads them inside the database container, under their
# AWS names, from scripts/db/walg.env: copy scripts/db/walg.env.example and fill it
# in. See docs/runbooks/backups.md.

# --- instagram and facebook page (Task D1) ---
INSTAGRAM_APP_ID=
# also the HMAC key for /instagram/webhook
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
# also the HMAC key for /messenger/webhook
FACEBOOK_APP_SECRET=
# any string; echoed back on the hub handshake
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Fernet key; empty = no Meta token can be stored
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v21.0

# --- nightly audit (Task E4) ---
# where the nightly audit report and every alert go
OPS_EMAIL=
JUDGE_MODEL=gemini-3.5-flash-lite                   # thinking enabled; gemini-2.5-pro 404s on a new AI Studio key

# --- monitoring and alerts (Task E7) ---
# One SMS per incident per six hours on top of the email; empty = email only. Sent from the
# first tenant sms_from_number the registry knows, so it needs a verified number to work.
OPS_SMS_NUMBER=
# Error reporting is optional and off unless this is set; PII is scrubbed either way.
SENTRY_DSN=
# "json" makes loguru emit one JSON object per line; anything else keeps the console format.
LOG_FORMAT=text

# --- whatsapp staff delivery (whatsapp plan, Task W1) ---
# The WhatsApp business number Meta assigns and the token its Cloud API calls carry.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# HMAC key for POST /whatsapp/webhook; usually the same value as FACEBOOK_APP_SECRET
WHATSAPP_APP_SECRET=
# any string; echoed back on the hub handshake
WHATSAPP_VERIFY_TOKEN=
# Approved template names, used whenever the 24-hour customer-service window is shut
WHATSAPP_TEMPLATE_ITEM=front_desk_item
WHATSAPP_TEMPLATE_DIGEST=front_desk_digest
WHATSAPP_TEMPLATE_LANG=en
# The staff number tracked items go to, in E.164. Referenced by the tenant bundle by name.
SKINCENTRIX_WHATSAPP_STAFF=

# --- sms staff delivery (plan S) ---
# The owner mobile every tracked item is texted to, in E.164. Referenced by the tenant
# bundle by NAME only, so a personal number never enters the repo. This number is also
# authorised to work the ledger by reply: ACK <id>, DONE <id>, LIST, #<id> <words>.
# Those replies arrive on POST /telnyx/sms, so the Telnyx messaging profile's webhook must
# point at the runtime (or at the edge worker), and either EDGE_SHARED_KEY or
# TELNYX_PUBLIC_KEY above must be set or every reply is rejected with 401.
SKINCENTRIX_STAFF_SMS=
